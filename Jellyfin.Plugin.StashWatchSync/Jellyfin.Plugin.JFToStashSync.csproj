<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JFToStashSync</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.JFToStashSync</AssemblyName>
    <AssemblyVersion>1.2.0.3</AssemblyVersion>
    <FileVersion>1.2.0.3</FileVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG</DefineConstants>
    <Optimize>false</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>NU1605</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Common" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\\configPage.html" />
    <EmbeddedResource Include="Configuration\\configPage.html" />
    <None Remove="Web\\player-o-button.js" />
    <EmbeddedResource Include="Web\\player-o-button.js" />
    <None Remove="Web\\trending-home.js" />
    <EmbeddedResource Include="Web\\trending-home.js" />
    <None Remove="Web\\popularity-home.js" />
    <EmbeddedResource Include="Web\\popularity-home.js" />
    <None Remove="Web\\babepedia-actor-stats.js" />
    <EmbeddedResource Include="Web\\babepedia-actor-stats.js" />
    <None Remove="Web\\pornhub-actor-stats.js" />
    <EmbeddedResource Include="Web\\pornhub-actor-stats.js" />
    <None Remove="Web\\babepedia-top-home.js" />
    <EmbeddedResource Include="Web\\babepedia-top-home.js" />
    <None Remove="Web\\performer-popularity-home.js" />
    <EmbeddedResource Include="Web\\performer-popularity-home.js" />
    <None Remove="Web\ranked-performer-flags.js" />
    <EmbeddedResource Include="Web\ranked-performer-flags.js" />
    <None Remove="Web\pornhub-featured-banner.js" />
    <EmbeddedResource Include="Web\pornhub-featured-banner.js" />
    <EmbeddedResource Include="Web\featured-media-banner.js" />
    <EmbeddedResource Include="Web\home-initial-loader.js" />
    <EmbeddedResource Include="Web\home-data-warmup.js" />
    <EmbeddedResource Include="Web\person-detail-enhancements.js" />
    <EmbeddedResource Include="Web\ui-i18n.js" />
    <EmbeddedResource Include="Resources\country_iso2_map.json" />
  </ItemGroup>

</Project>
